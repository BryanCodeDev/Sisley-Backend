# ============================================================
# BACKEND — SISLEY COLOMBIA
# ============================================================
# Configurar en Railway como variables de entorno
# ============================================================

# Entorno
# Railway: production
NODE_ENV=production

# Puerto
# Railway: se asigna automáticamente
PORT=3001

# ============================================================
# BASE DE DATOS — MySQL en Railway
# Acepta DB_* o MYSQL_* (variables nativas de Railway)
# ============================================================
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# ============================================================
# JWT — Secreto para firmar tokens
# Generar uno seguro en Railway
# ============================================================
JWT_SECRET=

# ============================================================
# CORS — URL del frontend en Netlify
# ============================================================
NEXT_PUBLIC_FRONTEND_URL=https://sisleyy.netlify.app

# ============================================================
# INTEGRACIONES — No implementadas en esta fase
# ============================================================
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

FACTUS_API_URL=
FACTUS_API_KEY=
