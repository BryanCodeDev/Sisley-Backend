# ============================================================
# BACKEND — SISLEY COLOMBIA
# ============================================================
# Producción Railway: variables de entorno en el servicio backend
# Desarrollo local: copiar como .env y cambiar a localhost
# ============================================================

# Entorno
# Desarrollo: development
# Railway: production
NODE_ENV=production

# Puerto
# Desarrollo local: 3001
# Railway: se asigna automáticamente via process.env.PORT
PORT=3001

# ============================================================
# BASE DE DATOS — MySQL en Railway
# ============================================================
DB_HOST=mysql.railway.internal
DB_PORT=3306
DB_USER=root
DB_PASSWORD=zFyHYOaNWVjpOjPJamRBufLkBeRsqZUv
DB_NAME=sisley_platform

# ============================================================
# JWT — Secreto para firmar tokens
# ============================================================
JWT_SECRET=sisley-colombia-2026-produccion-seguro-cambiar

# ============================================================
# CORS — URL del frontend
# Desarrollo local: http://localhost:3000
# Producción (Netlify): https://sisleyy.netlify.app
# IMPORTANTE: usar FRONTEND_URL, no NEXT_PUBLIC_FRONTEND_URL,
# porque Next.js captura NEXT_PUBLIC_* en build time.
# ============================================================
FRONTEND_URL=https://sisleyy.netlify.app

# ============================================================
# INTEGRACIONES — No implementadas en esta fase
# ============================================================
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

FACTUS_API_URL=
FACTUS_API_KEY=
